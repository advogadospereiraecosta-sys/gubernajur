# ===========================================
# Gubernajur - Environment Variables
# ===========================================

# Database
DATABASE_URL="postgresql://gubernajur:gubernajur_secret_password@localhost:5432/gubernajur?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="nextauth-secret-change-in-production"

# API
API_URL="http://localhost:3001"
API_SECRET="api-secret-change-in-production"

# App URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Integrações (opcional)
# TJ_API_KEY=""
# GOOGLE_CALENDAR_CLIENT_ID=""
# GOOGLE_CALENDAR_CLIENT_SECRET=""

# E-mail (opcional)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Ambiente
NODE_ENV="development"
