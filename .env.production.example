# ─── Produção — app.pereiraecostaadvogados.com.br ───────────────────────────
# VPS Hostinger 147.79.81.96 (Caddy já instalado, servindo outra aplicação)
# Copie para .env na VPS e preencha. NUNCA versione o .env preenchido.
# Gere cada segredo com:  openssl rand -base64 32

APP_DOMAIN=app.pereiraecostaadvogados.com.br
APP_URL=https://app.pereiraecostaadvogados.com.br

# Banco (o Postgres roda em rede interna; esta senha não trafega na internet)
DB_PASSWORD=

# Sessões e tokens
NEXTAUTH_SECRET=
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Claude — usado pela integração e pelo conector MCP
ANTHROPIC_API_KEY=

# Autentique — assinatura de contrato, procuração e declaração
AUTENTIQUE_API_TOKEN=
AUTENTIQUE_SANDBOX=false
# Sem este segredo o webhook aceita qualquer POST. Defina antes de expor.
AUTENTIQUE_WEBHOOK_SECRET=

# SMTP (convites de equipe e recuperação de senha)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
