# Dockerfile for Gubernajur Web (Next.js)

FROM node:20-alpine AS base

# Install dependencies only when needed
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/

# Install dependencies
RUN npm install -g pnpm@9.1.0
RUN pnpm install --frozen-lockfile

# Rebuild the source code only when needed
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Install pnpm locally
RUN npm install -g pnpm@9.1.0

# Install all monorepo dependencies (needed for workspace resolution)
RUN pnpm install --frozen-lockfile

# Generate Prisma Client (schema is at root prisma/schema.prisma)
RUN npx prisma generate --schema prisma/schema.prisma

# Build the application
ENV NEXT_TELEMETRY_DISABLED 1
RUN pnpm --filter @gubernajur/web build

# Production image
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED 1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 gubernajur

# Copy built application and install production dependencies
COPY --from=builder /app/apps/web/.next/standalone ./
COPY --from=builder /app/apps/web/.next/static ./.next/static
COPY --from=builder /app/apps/web/public ./public
COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-lock.yaml ./
COPY --from=builder /app/pnpm-workspace.yaml ./
COPY --from=builder /app/apps/web/package.json ./apps/web/

RUN npm install -g pnpm@9.1.0 && \
    pnpm install --frozen-lockfile --prod

USER gubernajur

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
