FROM node:20-alpine AS deps
WORKDIR /app
RUN apk add --no-cache libc6-compat openssl && npm install -g pnpm@9.1.0
COPY .npmrc ./
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
RUN pnpm install --frozen-lockfile

FROM node:20-alpine AS builder
WORKDIR /app
RUN apk add --no-cache libc6-compat openssl && npm install -g pnpm@9.1.0
COPY --from=deps /app/node_modules /app/node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN npx prisma generate --schema prisma/schema.prisma
RUN pnpm --filter @gubernajur/web build

FROM node:20-alpine AS runner
WORKDIR /app/apps/web
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN apk add --no-cache openssl && \
    addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 gubernajur
COPY --from=builder --chown=gubernajur:nodejs /app/apps/web/.next /app/apps/web/.next
COPY --from=builder --chown=gubernajur:nodejs /app/apps/web/public /app/apps/web/public
COPY --from=builder --chown=gubernajur:nodejs /app/apps/web/package.json /app/apps/web/package.json
COPY --from=builder --chown=gubernajur:nodejs /app/apps/web/next.config.js /app/apps/web/next.config.js
COPY --from=builder --chown=gubernajur:nodejs /app/node_modules /app/node_modules
COPY --from=builder --chown=gubernajur:nodejs /app/prisma /app/prisma
RUN chown -R gubernajur:nodejs /app/apps/web/.next
USER gubernajur
EXPOSE 3000
CMD ["sh", "-c", "node /app/node_modules/next/dist/bin/next start"]
