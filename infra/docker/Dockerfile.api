# Dockerfile for Gubernajur API (NestJS)

FROM node:20-alpine AS base

# Install dependencies only when needed
FROM base AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json ./apps/api/

# Install dependencies
RUN npm install -g pnpm@9.1.0
RUN pnpm install --frozen-lockfile

# Rebuild the source code only when needed
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Install pnpm locally (the binary from deps stage has broken references)
RUN npm install -g pnpm@9.1.0

# Generate Prisma Client
RUN pnpm --filter @gubernajur/api prisma generate

# Build the application
RUN pnpm --filter @gubernajur/api build

# Production image
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 gubernajur

# Copy built application
COPY --from=builder /app/apps/api/dist ./dist
COPY --from=builder /app/apps/api/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/api/prisma ./prisma

# Prisma migrations
RUN npx prisma migrate deploy

USER gubernajur

EXPOSE 3001

CMD ["node", "dist/main"]
